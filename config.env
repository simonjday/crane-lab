# crane-lab configuration — sourced by every script. Override by exporting before running.

# ---- Clusters (kind on the existing Podman machine) ---------------------------
: "${PODMAN_MACHINE:=podman-machine-default}"
: "${PODMAN_MIN_MEM_MIB:=10240}"
: "${SRC_CLUSTER:=crane-src}"
: "${DST_CLUSTER:=crane-dst}"
: "${SRC_CTX:=kind-${SRC_CLUSTER}}"
: "${DST_CTX:=kind-${DST_CLUSTER}}"
: "${KIND_NODE_IMAGE:=}"                     # empty = kind default
: "${KIND_NETWORK:=kind}"                    # Podman network shared by both clusters + the object store

# ---- Host ports (127.0.0.1 only; must be >=1024 on macOS + Podman) ------------
: "${LISTEN_ADDRESS:=127.0.0.1}"
: "${SRC_APP_PORT:=9080}"                    # shop on crane-src  (NodePort 30080)
: "${DST_APP_PORT:=9081}"                    # shop on crane-dst  (NodePort 30080)
: "${DST_HTTP_PORT:=9090}"                   # Contour/Envoy Gateway on crane-dst (NodePort 30090) → Argo CD, Gitea UIs
: "${GITEA_PORT:=3001}"                      # Gitea NodePort 30300 for git push (3000 is used by mta-lab)
: "${LAB_DOMAIN:=127.0.0.1.nip.io}"

# ---- App ---------------------------------------------------------------------
: "${APP_NS:=shop}"
: "${PVC_NAME:=redis-data}"
: "${PODINFO_TAG:=6.17.0}"
: "${REDIS_TAG:=7.4-alpine}"

# ---- Gitea (in crane-dst) ----------------------------------------------------
: "${GITEA_ADMIN_USER:=gitea_admin}"
: "${GITEA_ADMIN_PASSWORD:=ChangeMe-Crane-2026!}"
: "${GITEA_REPO:=crane-lab}"
: "${GITEA_INCLUSTER_URL:=http://gitea-http.gitea.svc.cluster.local:3000/${GITEA_ADMIN_USER}/${GITEA_REPO}.git}"

# ---- Object store for the PVC transfer (crane transfer-pvc indirect mode) ----
# An S3 endpoint on the shared Podman network, outside both clusters, reachable from both.
# rclone's own S3 server: one small multi-arch container, no extra tooling.
: "${OBJ_CONTAINER:=crane-objstore}"
: "${OBJ_IMAGE:=docker.io/rclone/rclone:latest}"   # pin a version for repeatability
: "${OBJ_ACCESS_KEY:=crane}"
: "${OBJ_SECRET_KEY:=crane-lab-secret}"
: "${OBJ_BUCKET:=crane-transfer}"
: "${OBJ_REMOTE:=objstore}"                   # rclone remote name used in --cloud-storage

# ---- Pinned tool / chart versions --------------------------------------------
: "${CRANE_VERSION:=v0.11.1}"
: "${CONTOUR_VERSION:=v1.33.6}"               # static-provisioning Gateway render
: "${GATEWAY_API_VERSION:=v1.3.0}"            # only if the Contour render doesn't bundle the CRDs
: "${ARGOCD_CHART_VERSION:=}"                 # empty = latest
: "${ARGOCD_APPS_CHART_VERSION:=}"
: "${GITEA_CHART_VERSION:=}"
# crane's default transfer image (quay.io/konveyor/rsync-transfer:latest) is amd64-only.
# On Apple Silicon the lab builds it from source and side-loads it (scripts/35-rsync-image.sh).
# Indirect mode uses this same image (it bundles rclone with the S3 backend).
if [[ "$(uname -m)" == "arm64" || "$(uname -m)" == "aarch64" ]]; then
  : "${RSYNC_IMAGE:=localhost/konveyor/rsync-transfer:arm64-local}"
else
  : "${RSYNC_IMAGE:=quay.io/konveyor/rsync-transfer:latest}"
fi
: "${RSYNC_TRANSFER_REF:=}"                   # git ref of konveyor/rsync-transfer; empty = default branch (master)
: "${CURL_IMAGE:=docker.io/curlimages/curl:8.11.1}"

# ---- Working dirs ------------------------------------------------------------
: "${WORK_DIR:=${LAB_ROOT:-.}/migration}"      # crane export/transform/output — gitignored
: "${SECRETS_DIR:=${LAB_ROOT:-.}/.secrets}"    # rclone.conf — gitignored
